{
  "name": "Shell Script",
  "scopeName": "source.shell",
  "type": "tree-sitter",
  "parser": "tree-sitter-bash",
  "fileTypes": [
    "sh",
    "bash",
    "ksh",
    "zsh",
    "zsh-theme",
    "zshenv",
    "zlogin",
    "zlogout",
    "zprofile",
    "zshrc",
    "bashrc",
    "bash_aliases",
    "bash_profile",
    "bash_login",
    "profile",
    "bash_logout",
    "PKGBUILD",
    "install",
    "cygport",
    "bats",
    "ebuild"
  ],
  "firstLineRegex": [
    // shebang line
    "^#![ \\t]*(?:/[^\\r\\n \\t]*/(?:bash|sh|ksh|zsh)|/[^\\r\\n \\t]*/env[ \\t]+(?:-S[ \\t]+)?(?:bash|sh|ksh|zsh))(?=[ \\t\\r\\n]|$)[^\\r\\n]*(?:\\r?\\n|$)",
    // vim modeline
    // Stop at the first Vim and set tokens instead of backtracking over them.
    // \x0a keeps existing shebang prefix line counts unchanged.
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=(sh|bash|ksh|zsh)"
  ],
  // Exact names for Bash, generic shell fences and the compatible zsh syntax.
  "injectionNames": ["bash", "sh", "shell", "shell-script", "zsh"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-bash#v0.25.1",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "bash.wasm",
    "highlightsQuery": "bash-highlights.scm",
    "tagsQuery": "bash-tags.scm",
    "foldsQuery": "bash-folds.scm",
    "indentsQuery": "bash-indents.scm",
    "injectionsQuery": "bash-injections.scm"
  },
  "comments": {
    "start": "# "
  }
}
